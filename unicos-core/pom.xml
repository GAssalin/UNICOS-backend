<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.unicos</groupId>
        <artifactId>unicos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../unicos-parent/pom.xml</relativePath>
    </parent>

    <artifactId>unicos-core</artifactId>
    <packaging>pom</packaging>

    <name>UNICOS :: Core Modules</name>

    <description>
        Módulo principal de domínios e componentes centrais do ecossistema UniCoS (Unique Control System).

        O projeto unicos-core reúne os módulos fundamentais utilizados pelos microserviços do UniCoS,
        mantendo coesão de entidades, regras de domínio e contratos de dados entre contextos.

        Submódulos:
        - core-base
        - core-auth
        - core-tenant
        - core-usuario
        - core-pessoas
        - core-web
    </description>

    <modules>
        <module>core-base</module>
        <module>core-auth</module>
        <module>core-tenant</module>
        <module>core-usuario</module>
        <module>core-pessoas</module>
        <module>core-web</module>
    </modules>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - UniCoS</name>
            <url>https://maven.pkg.github.com/GAssalin/UNICOS</url>
        </repository>
    </distributionManagement>

</project>
