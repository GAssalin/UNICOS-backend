          "mode": "raw",
          "raw": "{\n  \"empresaId\": 1,\n  \"regimeTributario\": \"LUCRO_PRESUMIDO\",\n  \"inscricaoEstadual\": \"123456789\",\n  \"inscricaoMunicipal\": \"987654321\",\n  \"cnaePrincipal\": \"6202-3/00\",\n  \"aliquotaIss\": 3.0,\n  \"incentivoFiscal\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/configuracoes-fiscais/1",
