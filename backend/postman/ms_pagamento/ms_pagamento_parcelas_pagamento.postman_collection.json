            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": 1,\n  \"valor\": 175.37,\n  \"dataVencimento\": \"2025-12-03\",\n  \"status\": \"PENDENTE\"\n}"
        },
        "url": "{{baseUrl}}/parcelas-pagamento/1"
