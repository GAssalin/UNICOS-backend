{
  "info": {
    "name": "ms-pagamentos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "conta-collection-id"
  },
  "item": [
    {
      "name": "Listar todos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/contas-financeiras"
      }
    },
    {
      "name": "Buscar por ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/contas-financeiras/1"
      }
    },
    {
      "name": "Criar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Conta Corrente Bradesco\",\n  \"tipoConta\": \"CONTA_CORRENTE\",\n  \"saldoAtual\": 10250.55\n}"
        },
        "url": "{{baseUrl}}/contas-financeiras"
      }
    },
    {
      "name": "Atualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Conta Corrente Bradesco\",\n  \"tipoConta\": \"CONTA_CORRENTE\",\n  \"saldoAtual\": 10250.55\n}"
        },
        "url": "{{baseUrl}}/contas-financeiras/1"
      }
    },
    {
      "name": "Deletar",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/contas-financeiras/1"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/v1"
    }
  ]
}