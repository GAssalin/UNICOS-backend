{
  "info": {
    "name": "ms_auth_tokens",
    "description": "Endpoints da controller de Tokens do ms-auth",
    "_postman_id": "auto-ms_auth_tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Registrar Token",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/v1/tokens?token=abc123&usuarioId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "v1",
            "tokens"
          ],
          "query": [
            {
              "key": "token",
              "value": "abc123"
            },
            {
              "key": "usuarioId",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "Listar Tokens por Usu\u00e1rio",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/auth/v1/tokens/usuario/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "v1",
            "tokens",
            "usuario",
            "1"
          ]
        }
      }
    }
  ]
}