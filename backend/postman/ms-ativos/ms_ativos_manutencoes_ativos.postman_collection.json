                "method": "GET",
                "url": "{{baseUrl}}/v1/manutencoes-ativos/periodo?inicio=2025-11-01&fim=2025-11-30"
            }
        },
        {
            "name": "Buscar manutenções agendadas para data específica",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/v1/manutencoes-ativos/agendadas?data=2025-11-10"
