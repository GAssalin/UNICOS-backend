{
    "info": {
        "name": "ms_ativos_manutencoes_ativos",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Listar todas as manutenções",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/v1/manutencoes-ativos"
            }
        },
        {
            "name": "Buscar manutenção por ID",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/v1/manutencoes-ativos/1"
            }
        },
        {
            "name": "Criar nova manutenção de ativo",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"ativoId\": 1,\n    \"fornecedorId\": 2,\n    \"tipo\": \"PREVENTIVA\",\n    \"descricaoServico\": \"Troca de filtros e limpeza geral\",\n    \"dataManutencao\": \"2025-11-10\",\n    \"custo\": 350.00,\n    \"status\": \"ABERTA\"\n}"
                },
                "url": "{{baseUrl}}/v1/manutencoes-ativos"
            }
        },
        {
            "name": "Atualizar manutenção existente",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"ativoId\": 1,\n    \"fornecedorId\": 2,\n    \"tipo\": \"CORRETIVA\",\n    \"descricaoServico\": \"Substituição de peça danificada\",\n    \"dataManutencao\": \"2025-11-12\",\n    \"custo\": 480.00,\n    \"status\": \"CONCLUIDA\"\n}"
                },
                "url": "{{baseUrl}}/v1/manutencoes-ativos/1"
            }
        },
        {
            "name": "Excluir manutenção por ID",
            "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/v1/manutencoes-ativos/1"
            }
        },
        {
            "name": "Buscar manutenções por ativo",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/v1/manutencoes-ativos/ativo/1"
            }
        },
        {
            "name": "Buscar manutenções por fornecedor",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/v1/manutencoes-ativos/fornecedor/2"
