<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Herda configurações e versões do unicos-core -->
    <parent>
        <groupId>br.com.unicos</groupId>
        <artifactId>unicos-core</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>core-usuario</artifactId>
    <name>UNICOS :: Core Usuario</name>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <description>
        Módulo central responsável por prover contratos e abstrações técnicas
        para suporte a arquitetura multi-tenant no ecossistema UniCoS.

        Este módulo define componentes reutilizáveis para dados de usuários e
        garantem isolamento de dados entre empresas nos microserviços.

        O core-tenant não contém regras de negócio nem dependências de infraestrutura,
        servindo exclusivamente como base técnica compartilhada entre os serviços.
    </description>

    <dependencies>

        <!-- Base comum do ecossistema UniCoS -->
        <dependency>
            <groupId>br.com.unicos</groupId>
            <artifactId>core-base</artifactId>
        </dependency>

        <!-- Jakarta Persistence API (para BaseTenantEntity / repositórios base) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 🧩 Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web (OncePerRequestFilter, HttpServletRequest, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Servlet API -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Starter Data JPA (necessário para integração com entidades) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Validation API (opcional, para contratos base) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
