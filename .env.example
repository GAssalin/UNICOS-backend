########################################
# AMBIENTE
########################################
# Profile Spring (local, homolog, prod).
SPRING_PROFILES_ACTIVE=

########################################
# PUBLICACAO NO HOST (Docker Compose)
########################################
# Gateway: unico ponto de entrada. Use 0.0.0.0 apenas se precisar aceitar conexoes externas.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8082
# Painel do Eureka (publicado apenas com compose.homolog.yml).
EUREKA_BIND_ADDRESS=127.0.0.1
EUREKA_PORT=8081

# Origens aceitas pelo CORS do gateway, separadas por virgula (ex.: https://app.unicos.com.br).
CORS_ALLOWED_ORIGINS=*
# Portal /docs do gateway (desligado automaticamente no profile prod).
UNICOS_DOCS_ENABLED=true

########################################
# EUREKA (execucao fora do Docker)
########################################
EUREKA_URL=

########################################
# BANCOS DE DADOS
# Os *_HOST e *_PORT so sao usados na execucao fora do Docker;
# no Compose, cada servico acessa o seu MySQL pela rede interna e o usuario
# root de cada MySQL recebe uma senha aleatoria (exibida no log da primeira inicializacao).
########################################
PESSOA_DB_NAME=
PESSOA_DB_HOST=
PESSOA_DB_PORT=
PESSOA_DB_USER=
PESSOA_DB_PASSWORD=

PERMISSAO_DB_NAME=
PERMISSAO_DB_HOST=
PERMISSAO_DB_PORT=
PERMISSAO_DB_USER=
PERMISSAO_DB_PASSWORD=

EMPRESA_DB_NAME=
EMPRESA_DB_HOST=
EMPRESA_DB_PORT=
EMPRESA_DB_USER=
EMPRESA_DB_PASSWORD=

CLIENTE_DB_NAME=
CLIENTE_DB_HOST=
CLIENTE_DB_PORT=
CLIENTE_DB_USER=
CLIENTE_DB_PASSWORD=

ESTOQUE_DB_NAME=
ESTOQUE_DB_HOST=
ESTOQUE_DB_PORT=
ESTOQUE_DB_USER=
ESTOQUE_DB_PASSWORD=

PRODUTO_DB_NAME=
PRODUTO_DB_HOST=
PRODUTO_DB_PORT=
PRODUTO_DB_USER=
PRODUTO_DB_PASSWORD=

########################################
# RABBITMQ (opcional: profile "mensageria" do Compose)
########################################
RABBITMQ_USER=
RABBITMQ_PASSWORD=

########################################
# SEGURANCA
########################################
# Emissor e segredo HMAC dos tokens JWT (minimo de 32 caracteres).
UNICOS_JWT_ISSUER=
UNICOS_JWT_SECRET=
# Expiracao em minutos do access token e do refresh token.
UNICOS_TEMPO_EXP_TOKEN=15
UNICOS_TEMPO_EXP_REFRESH_TOKEN=1440
# Segredo das chamadas internas entre servicos (minimo de 16 caracteres).
UNICOS_INTERNAL_TOKEN=
# Protecao contra forca bruta: senhas incorretas por e-mail antes do bloqueio e duracao do bloqueio.
UNICOS_LOGIN_MAX_TENTATIVAS=5
UNICOS_LOGIN_BLOQUEIO=15m
